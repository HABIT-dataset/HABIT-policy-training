# OpenPI PI0.5 fine-tuning on a small subset of the HABIT dataset.
#
# HABIT is a bimanual LeRobot v2 dataset on the HuggingFace Hub. This example
# downloads the first ~10 episodes of the `sample` subset for a quick local
# sanity check.
#
# Usage:
#   set -a && source samples/envs/.env.habit && set +a
#   python -m local_training.train_local samples/envs/.env.habit

# --------------------------------------------------
# Run identification
# --------------------------------------------------
EXP_NAME=habit-pi05-local

# --------------------------------------------------
# OpenPI config selection
# --------------------------------------------------
# `bimanual_local` is registered at runtime by local_training/data_config.py
# from the env vars below.
OPENPI_CONFIG_NAME=bimanual_local
MODEL_VARIANT=pi05

# --------------------------------------------------
# Data: download a subset of HABIT from HuggingFace
# --------------------------------------------------
HF_DATASET_REPO=configinc/HABIT
HF_DATASET_SUBSET=sample
HF_NUM_EPISODES=10

# Local repo_id used by LeRobot to find the staged dataset under
# $HF_LEROBOT_HOME/<DATASET_REPO_ID>/.
DATASET_REPO_ID=habit_local

# PI0 expects three image slots named base_0_rgb / left_wrist_0_rgb /
# right_wrist_0_rgb. We map the three robot-mounted views onto those slots.
IMAGE_KEYS=base_0_rgb:observation.images.front_view,left_wrist_0_rgb:observation.images.left_wrist_view,right_wrist_0_rgb:observation.images.right_wrist_view

# Bimanual state: per-arm cartesian (6) + gripper (1) = 7-dim each, 14 total.
STATE_FIELDS=robot0.observation.state.cartesian_position,robot0.observation.state.gripper_position,robot1.observation.state.cartesian_position,robot1.observation.state.gripper_position

# Bimanual action: per-arm delta_action (7-dim each), 14 total.
ACTION_FIELDS=robot0.action.delta_action,robot1.action.delta_action

# PI0.5 architectural slot for actions; horizon matches the pi05_libero ref.
ACTION_DIM=32
ACTION_HORIZON=10

# --------------------------------------------------
# Training hyperparameters (small for a local sanity check)
# --------------------------------------------------
BATCH_SIZE=8
NUM_TRAIN_STEPS=200
NUM_WORKERS=2
SAVE_INTERVAL=100
LOG_INTERVAL=10
FSDP_DEVICES=1
SEED=42
OVERWRITE=true

LEARNING_RATE=5e-5
WARMUP_STEPS=50
DECAY_STEPS=200

# PI0.5 uses higher EMA decay than PI0.
EMA_DECAY=0.999

# --------------------------------------------------
# Pretrained weights (optional)
# --------------------------------------------------
# Public PI0.5 base weights on Google Cloud Storage. Comment out to train
# from scratch (you almost never want this for fine-tuning).
WEIGHT_LOADER_PATH=gs://openpi-assets/checkpoints/pi05_base/params

# --------------------------------------------------
# Logging
# --------------------------------------------------
WANDB_ENABLED=false
WANDB_PROJECT=openpi-local

# --------------------------------------------------
# Local cache layout
# --------------------------------------------------
# All artifacts (datasets, checkpoints, weights, JAX cache) live under
# $CACHE_ROOT. Defaults to ~/.cache/openpi-local if unset.
# CACHE_ROOT=/path/to/scratch/openpi-local
